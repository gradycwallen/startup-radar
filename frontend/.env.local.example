# Copy to .env.local (gitignored) and fill in. Server-side only — no NEXT_PUBLIC_ prefix, so Next.js
# never bundles these into browser JavaScript. The frontend only ever reads the database (no writes),
# and never calls the Anthropic API.
#
# Same values as the root project's .env (Supabase project settings -> API). If this file is left
# empty, the frontend falls back to a clearly-labeled sample/mock dataset (src/lib/mock) instead of
# failing — see src/lib/data/companies.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
